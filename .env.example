# Fallback only. The bot token is stored in the OS credential store
# (macOS Keychain / Secret Service / Windows Credential Manager) and edited with
# `monitask-center --config`; the chat id is an ordinary field in config.json.
# Copy this file to .env ONLY on a machine with no credential store, where
# `monitask-center install` falls back to writing the token here.
TG_BOT_TOKEN=123456:your-bot-token-here
TG_CHAT_ID=-1001234567890
